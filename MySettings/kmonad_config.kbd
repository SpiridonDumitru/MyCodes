
;; CONFIG       --------------------------------------------------------------------


(defcfg
  input  (device-file "/dev/input/by-id/usb-RDMCTMZT_QKRO_75K-event-kbd")
  output (uinput-sink "KMonad_QK75")
  fallthrough true
  allow-cmd true
)

;; SOURCE      ----------------------------------------------------------------------


(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  home pgup pgdn
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft      up
  lctl lmet lalt           spc            ralt rmet cmp  fn   rctl left down rght
)

;; ALIAS      -----------------------------------------------------------------------


(defalias
  ecap esc            ;; Caps devine Esc
  bsp  bspc           ;; Alias pentru Backspace
  
  tobase (layer-switch base)
  toapp  (layer-switch apps-layer)
  tomac  (layer-switch macros-layer)

  rng (cmd-button "sudo -u d DISPLAY=:0 alacritty -e ranger")
  fd (cmd-button "sudo -u d DISPLAY=:0 firedragon")
  sb (cmd-button "sudo -u d DISPLAY=:0 chromium")
  srch (cmd-button "sudo -u d DISPLAY=:0 alacritty -e ssh d@192.168.0.105")
  prox (cmd-button "sudo -u d DISPLAY=:0 alacritty -e ssh root@192.168.0.194")
)

;; BASE       ------------------------------------------------------------------------


(deflayer base
  @tobase @toapp  @tomac  _    _    _    _    _    _    _    _    _    _    _
  _       _       _       _    _    _    _    _    _    _    _    _    _    _
  _       _       _       _    _    _    _    _    _    _    _    _    _    _
  @ecap   _       _       _    _    _    _    _    _    _    _    _    _
  _       _       _       _    _    _    _    _    _    _    _    @bsp _
  _       _       _              _              _    _    _    _    _    _    _    _
)

;; APPS       -------------------------------------------------------------------------


(deflayer apps-layer
  @tobase _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _   @rng  _    _    _    _  @prox  _    _    _
  _       _  @srch  _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    @fd  @sb  _    _    _    _    @bsp      _
  _       _    _              _              _    _    _    _    _    _    _    _
)

;; MACROS      ------------------------------------------------------------------------


(deflayer macros-layer
  @tobase _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _              _              _    _    _    _    _    _    _    _
)

