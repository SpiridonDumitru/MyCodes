#! /bin/sh

wmname LG3D &
vmware-user-suid-wrapper &

pgrep -x sxhkd > /dev/null || sxhkd &

# Give EVERY monitor the same 10 desktops (I..X).
# The old single "bspc monitor -d ..." line only configured one monitor,
# so the other one was left with a single static default desktop.
for m in $(bspc query -M --names); do
    bspc monitor "$m" -d I II III IV V VI VII VIII IX X
done

bspc config border_width 2
bspc config window_gap 12

bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true

# RULES
~/.config/bspwm/rules
bspc config external_rules_command ~/.config/bspwm/external_rules

# WALLPAPER
feh --bg-fill ~/.config/Wallpaper/*.jpg

# POLYBAR
~/.config/polybar/launch.sh

# CUSTOM
bspc config focus_follows_pointer true

# PICOM
pgrep -x picom > /dev/null || picom --daemon --log-level=error

bspc config active_border_color "#a486dd"
bspc config normal_border_color "#a486dd"

xsetroot -cursor_name left_ptr &
